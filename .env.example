# Copy to .env. Every value is optional: the project runs fully offline without any of them.

# --- Pipeline ---
TRACKER_DB_PATH=data/tracker.duckdb
TRACKER_LOG_LEVEL=INFO
# console (pretty, local) or json (CI / containers)
TRACKER_LOG_FORMAT=console

# --- LLM layer (optional; falls back to embeddings/regex/templates without it) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Alerts (optional; console notifier is used when neither is set) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
